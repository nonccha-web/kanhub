{
  // Cloudflare Worker — เว็บการตลาด (โดเมนหลัก) + หลังบ้าน ERP (admin subdomain)
  // worker.js route ตาม hostname, static assets จาก out/
  "name": "kanhub",
  "compatibility_date": "2025-06-01",
  "main": "./worker.js",
  "d1_databases": [
    {
      "binding": "KAN_ERP",
      "database_name": "kan-erp",
      "database_id": "c45f9c3f-7e4d-45a2-b318-af22bf2ac87d"
    }
  ],
  // บอต Lark แจ้งงาน 3 รอบ/วัน เวลาไทย 10:00 / 14:30 / 17:30 (UTC = ไทย −7)
  // webhook อยู่ใน secret LARK_KAN_WEBHOOK ไม่ใช่ที่นี่
  // 13:00 UTC = 20:00 ไทย = รอบเตือนงานที่ดองรอตรวจ เข้ากลุ่ม "เตือนตรวจงาน" (ใช้ Lark App ไม่ใช่ webhook)
  "triggers": { "crons": ["0 3 * * *", "30 7 * * *", "30 10 * * *", "0 13 * * *"] },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
